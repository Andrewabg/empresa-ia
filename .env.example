# Awave Agents — variáveis do deploy (EasyPanel). Copie para .env e preencha.
# As chaves da OpenAI, do GitHub e do Composio NÃO vão aqui — você cola no painel
# /config depois que o app subir (ficam guardadas no Supabase Vault). Guia: docs/DEPLOY.md.

# OBRIGATÓRIAS ────────────────────────────────────────────────────────────────

# Supabase → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Settings → Database → Connection string → aba "Session pooler" (porta 5432).
# Aplica as migrations sozinho no boot. Use a Session pooler — NÃO a Direct connection
# (host db.<ref>...) nem o Transaction pooler (6543).
SUPABASE_DB_URL=

# Seu domínio público — ex.: https://app.seudominio.com
NEXT_PUBLIC_BASE_URL=

# Só isto. Não é preciso repetir nada na aba "Build" do EasyPanel: o app lê a conexão
# em runtime e a entrega ao navegador sozinho.

# OPCIONAIS (já têm padrão; descomente a linha só para trocar) ─────────────────
# OPENAI_REALTIME_VOICE=cedar
# OPENAI_MODEL=gpt-5.1
# Modelo BARATO dos jobs de fundo (reflexão, rollup, curador-crítico, extração).
# Default gpt-5-mini (id real da OpenAI); se sua conta não tiver, os jobs caem sozinhos
# pro OPENAI_MODEL (fallback automático). Aponte pro seu modelo barato preferido.
# CHEAP_MODEL=gpt-5-mini
# EMBEDDING_MODEL=text-embedding-3-small
